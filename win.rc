#include <winver.h>

// Tray / Explorer icon, baked into the exe.
1 ICON "assets\\the-rock.ico"

// RT_MANIFEST
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "TheRockWare"
      VALUE "FileDescription",  "Pops The Rock at your cursor on every click"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "therockware"
      VALUE "OriginalFilename", "therockware.exe"
      VALUE "ProductName",      "TheRockWare"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "LegalCopyright",   "MIT licensed"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
